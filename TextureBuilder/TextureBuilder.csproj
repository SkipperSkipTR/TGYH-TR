<Project Sdk="Microsoft.NET.Sdk">
  <!-- Offline tool: encodes replacement PNGs into prebuilt .tgyc textures using the plugin's own encoder. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Plugin\PngRowReader.cs" />
    <Compile Include="..\Plugin\BlockCompression.cs" />
    <Compile Include="..\Plugin\TextureEncoder.cs" />
    <Compile Include="..\Plugin\TextureCacheFile.cs" />
  </ItemGroup>
</Project>
